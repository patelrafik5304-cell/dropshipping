<header class="bg-white shadow-lg sticky top-0 z-50">
  <div class="container mx-auto px-4 py-4 flex justify-between items-center">
    <div class="flex items-center">
      <div class="w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center mr-3">
        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
      </div>
      <a href="/" class="text-2xl font-bold text-gray-800">{{ shop.name }}</a>
    </div>
    <nav class="hidden md:flex space-x-8 items-center">
      <a href="/" class="text-gray-700 hover:text-blue-600 font-medium transition duration-300">Home</a>
      <a href="/collections/all" class="text-gray-700 hover:text-blue-600 font-medium transition duration-300">Products</a>
      <a href="/pages/about" class="text-gray-700 hover:text-blue-600 font-medium transition duration-300">About</a>
      <a href="/pages/contact" class="text-gray-700 hover:text-blue-600 font-medium transition duration-300">Contact</a>
      <a href="/cart" class="relative text-gray-700 hover:text-blue-600 font-medium transition duration-300">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4m0 0L7 13m0 0l-1.1 5H19M7 13v8a2 2 0 002 2h10a2 2 0 002-2v-3" />
        </svg>
        {% if cart.item_count > 0 %}
          <span class="absolute -top-2 -right-2 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center">
            {{ cart.item_count }}
          </span>
        {% endif %}
      </a>
    </nav>
    <div class="md:hidden flex items-center space-x-4">
      <a href="/cart" class="relative text-gray-700 hover:text-blue-600">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4m0 0L7 13m0 0l-1.1 5H19M7 13v8a2 2 0 002 2h10a2 2 0 002-2v-3" />
        </svg>
        {% if cart.item_count > 0 %}
          <span class="absolute -top-2 -right-2 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center">
            {{ cart.item_count }}
          </span>
        {% endif %}
      </a>
      <button class="text-gray-700 hover:text-blue-600">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}