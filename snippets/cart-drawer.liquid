<div id="cart-drawer" class="fixed inset-0 z-50 hidden">
  <div class="absolute inset-0 bg-black bg-opacity-50" onclick="closeCart()"></div>
  <div class="absolute right-0 top-0 h-full w-96 bg-white shadow-lg">
    <div class="p-6">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold">Your Cart</h2>
        <button onclick="closeCart()" class="text-gray-500 hover:text-gray-700">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div id="cart-items" class="space-y-4 mb-6">
        <!-- Cart items will be populated here -->
      </div>
      <div class="border-t pt-4">
        <div class="flex justify-between items-center mb-4">
          <span class="text-lg font-semibold">Total:</span>
          <span id="cart-total" class="text-lg font-bold">$0.00</span>
        </div>
        <a href="/checkout" class="w-full bg-blue-600 text-white py-3 px-6 rounded-lg font-semibold hover:bg-blue-700 transition duration-300 block text-center">
          Checkout
        </a>
      </div>
    </div>
  </div>
</div>